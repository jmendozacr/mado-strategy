[importlinter]
root_packages =
    core
    ingestion
    primitives
    composite
    entries
    alignment
    policy
    backtest
    viz
    research

[importlinter:contract:layers]
name = Layered pipeline (ADR-01)
type = layers
# `alignment | policy` are declared INDEPENDENT siblings, not stacked:
# timeframe alignment and direction arbitration are separate concerns over
# the same evidence layers, and neither imports the other. Stacking them
# would silently permit a coupling nobody has argued for; a future consumer
# that genuinely needs one from the other should have to change this line.
layers =
    viz : ingestion
    backtest
    alignment | policy
    composite | entries
    primitives
    core

[importlinter:contract:no-research-in-production]
name = Research tooling must not leak into production layers
type = forbidden
# `cli` is deliberately absent from source_modules: it is a single top-level
# module (cli.py), not a package, and import-linter's root_packages/graph
# only accepts packages (dirs with __init__.py) -- adding it raises "is a
# module, not a package" (root_packages) or "does not exist" (contract
# source/forbidden modules referencing an unscanned module). This is a
# structural limitation of the tool, not a gap left open on purpose: cli.py
# importing `research` would need to be caught by code review, since it
# can't be graphed. Every actual package-shaped production layer is covered.
source_modules =
    backtest
    alignment
    entries
    composite
    policy
    viz
forbidden_modules =
    research

[importlinter:contract:no-policy-in-research]
name = Research tooling must not consume the policy layer
# The reverse direction of the contract above, which the layers contract
# cannot express (`research` is deliberately outside it). Line A explores
# the corpus; Line B's DirectionPolicy candidates are pre-registered
# hypotheses that must not be silently re-tuned from research findings.
type = forbidden
source_modules =
    research
forbidden_modules =
    policy

